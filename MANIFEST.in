include Makefile LICENSE README.md
include src/main.cpp
recursive-include src/pyhmd/native *.hpp *.cpp Makefile *.py
recursive-include src/pyhmd/presets *.ini
recursive-include configs *.ini
recursive-include docs *.md *.json
recursive-include examples *.json *.py *.example
recursive-include tests *.cpp *.py *.md
recursive-include scripts *.py *.sh
include python/*.py python/requirements.txt
global-exclude __pycache__ *.pyc
